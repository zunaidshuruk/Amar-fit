rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Part Q: Social (friends, challenges, leaderboard) ---

    // Public leaderboard projection: name/streak/points/badges/friendCode only,
    // no health data. Readable by any signed-in user; writable only by its owner.
    match /public_profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // STEP 3 (enable ONLY after every user is on an app version that no longer writes
      // fcmToken here, and the notification script reads tokens from users/{uid}):
      // replace the "allow write" line above with these two lines. Push tokens belong in
      // the private users/{uid} document, never in this world-readable one.
      //   allow create, update: if request.auth != null && request.auth.uid == uid
      //     && !request.resource.data.keys().hasAny(['fcmToken', 'fcmTokenUpdatedAt']);
      //   allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Friends-only projection: today's steps/water/sleep/calories vs. goals.
    // Readable by the owner, or by anyone with an accepted friendship with them.
    match /friend_stats/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (
          exists(/databases/$(database)/documents/friendships/$(request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/friendships/$(request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid)).data.status == 'accepted'
        )
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // One doc per friend pair, keyed by the two UIDs sorted and joined with "_".
    // The requester creates it as "pending"; only the OTHER party can accept it.
    // No cross-user writes are ever needed -- each side only ever writes documents
    // keyed by their own uid, or creates/updates a pair-doc they're a party to.
    match /friendships/{pairId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.uid1 || request.auth.uid == resource.data.uid2);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.requestedBy
        && (request.auth.uid == request.resource.data.uid1 || request.auth.uid == request.resource.data.uid2)
        && request.resource.data.status == 'pending'
        // CHANGED 2026-10-05: the doc id must be the two sorted uids, so nobody can
        // pre-create (squat) the pair doc of two other users.
        && request.resource.data.uid1 < request.resource.data.uid2
        && pairId == request.resource.data.uid1 + '_' + request.resource.data.uid2;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.uid1 || request.auth.uid == resource.data.uid2)
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.status == 'accepted';
      // CHANGED 2026-10-05: either party can delete the pair doc at ANY status --
      // declining/cancelling a pending request, or removing an accepted friend
      // (FirebaseManager.removeFriend). Previously only pending docs could be deleted,
      // so removing a friend was always denied.
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uid1 || request.auth.uid == resource.data.uid2);
    }

    // Reverse lookup: 5-char friend code -> uid. Claimed once via a transaction
    // (see FirebaseManager.claimFriendCode), never overwritten or deleted.
    match /friend_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // ADDED 2026-10-06: the owner may delete their own code (account deletion releases it).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // A 7-day steps challenge between two ACCEPTED friends.
    // HARDENED 2026-10-05 (was: either participant could rewrite anything except
    // identity/date fields, so you could edit the other person's progress or declare
    // yourself the winner at any time):
    //  - create: only between accepted friends, starting at 0 / 0, no winner yet.
    //  - progress updates: a participant may change ONLY their own progress entry,
    //    while the challenge is active (and for up to 2 days after its end date).
    //  - completion: only on/after the end date, only active -> completed, and
    //    winnerUid must be the actual leader of the stored progress (null on a tie).
    //  - a completed challenge can never be edited again by a client.
    // Limit: steps are self-reported by the app, so a person can still inflate THEIR
    // OWN number. No rule can verify Health Connect data; the cap below only blocks
    // absurd values.
    match /challenges/{challengeId} {
      function pairIdOf(a, b) {
        return a < b ? a + '_' + b : b + '_' + a;
      }
      // endDate is "YYYY-MM-DD" (see FirebaseManager.createChallenge)
      function endTs() {
        let p = resource.data.endDate.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      }
      function isParticipant() {
        return request.auth != null &&
          (request.auth.uid == resource.data.uid1 || request.auth.uid == resource.data.uid2);
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function ownProgressOnly() {
        return changedKeys().hasOnly(['progress'])
          && resource.data.status == 'active'
          && request.time < endTs() + duration.value(2, 'd')
          && request.resource.data.progress.diff(resource.data.progress).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.progress[request.auth.uid] is int
          && request.resource.data.progress[request.auth.uid] >= 0
          && request.resource.data.progress[request.auth.uid] <= 700000;
      }
      function expectedWinner() {
        let p = resource.data.progress;
        return p[resource.data.uid1] > p[resource.data.uid2] ? resource.data.uid1 :
          (p[resource.data.uid2] > p[resource.data.uid1] ? resource.data.uid2 : null);
      }
      // 14h of slack: the app decides "is it over" on the phone's local date (up to UTC+14).
      function completingCorrectly() {
        return changedKeys().hasOnly(['status', 'winnerUid'])
          && resource.data.status == 'active'
          && request.resource.data.status == 'completed'
          && request.time >= endTs() - duration.value(14, 'h')
          && request.resource.data.winnerUid == expectedWinner();
      }

      allow read: if isParticipant();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid1', 'uid2', 'createdBy', 'startDate', 'endDate', 'status', 'progress', 'winnerUid', 'createdAt', 'notifiedCreation', 'notifiedCompletion'])
        && request.auth.uid == request.resource.data.createdBy
        && (request.auth.uid == request.resource.data.uid1 || request.auth.uid == request.resource.data.uid2)
        && request.resource.data.uid1 != request.resource.data.uid2
        && request.resource.data.status == 'active'
        && request.resource.data.winnerUid == null
        && request.resource.data.progress.keys().hasOnly([request.resource.data.uid1, request.resource.data.uid2])
        && request.resource.data.progress[request.resource.data.uid1] == 0
        && request.resource.data.progress[request.resource.data.uid2] == 0
        && request.resource.data.notifiedCreation == false
        && request.resource.data.notifiedCompletion == false
        && get(/databases/$(database)/documents/friendships/$(pairIdOf(request.resource.data.uid1, request.resource.data.uid2))).data.status == 'accepted';
      allow update: if isParticipant() && (ownProgressOnly() || completingCorrectly());
      allow delete: if false;
    }

    // --- ADDED 2026-10-05: collections the app already uses that had no rules ---
    // (Firestore denies anything not matched, so these features were failing.)

    // Activity feed (FirebaseManager.postActivityEvent / getActivityFeed). Posted by
    // the user it describes. Readable by any signed-in user: the app loads friends'
    // events with a whereIn query, which rules cannot restrict to friends. Events are
    // short generic messages ("Earned a new badge!"), no health data.
    match /activity_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // ADDED 2026-10-06: the owner may delete their own events (account deletion).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Kudos: one doc per sender/recipient/day, id = fromUid_toUid_date
    // (FirebaseManager.sendKudos / hasSentKudosToday). Only the sender can create it.
    match /kudos/{kudosId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && kudosId == request.auth.uid + '_' + request.resource.data.toUid + '_' + request.resource.data.date;
      allow update, delete: if false;
    }

    // Direct messages between ACCEPTED friends. Thread id = the friendship pair id
    // (two sorted uids joined with "_"). Messages are immutable once sent; the
    // push-notification job (Admin SDK) updates the "notified" flag and is not
    // subject to these rules.
    match /dm_threads/{pairId}/messages/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in pairId.split('_')
        && get(/databases/$(database)/documents/friendships/$(pairId)).data.status == 'accepted';
      allow create: if request.auth != null
        && request.auth.uid in pairId.split('_')
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && get(/databases/$(database)/documents/friendships/$(pairId)).data.status == 'accepted';
      allow update: if false;
      // ADDED 2026-10-06: a sender may delete their own messages (account deletion cleanup).
      allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
    }
  }
}
