<?xml version="1.0" encoding="utf-8"?>
<!--
  KardIQ keeps health data (steps, sleep, glucose, cycle, medicine, messages) in its local database and preferences.
  Android backup is switched off (allowBackup="false" in the manifest); these rules say the same in case it is ever switched on by mistake:
  nothing is included. Data comes back from the user's own account (Firestore sync) or the in-app Google Drive backup, never from Android backup.
  Applies to Android 11 and older; see data_extraction_rules.xml for Android 12 and newer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
